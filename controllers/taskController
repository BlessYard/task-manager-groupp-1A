const taskStore = require('../data/tasks');

// GET /api/tasks
function getAllTasks(req, res) {
  res.json(taskStore.getAllTasks());
}

// GET /api/tasks/:id
function getTaskById(req, res) {
  const id = parseInt(req.params.id, 10);

  if (isNaN(id) || id < 1) {
    return res.status(400).json({ error: 'Invalid task ID. Must be a positive integer.' });
  }

  const task = taskStore.getTaskById(id);
  if (!task) {
    return res.status(404).json({ error: `Task with ID ${id} not found.` });
  }

  res.json(task);
}

// POST /api/tasks
function createTask(req, res) {
  const { title, description, status } = req.body;
  const task = taskStore.createTask({ title, description, status });
  res.status(201).json(task);
}

// PUT /api/tasks/:id
function updateTask(req, res) {
  const id = parseInt(req.params.id, 10);

  if (isNaN(id) || id < 1) {
    return res.status(400).json({ error: 'Invalid task ID. Must be a positive integer.' });
  }

  const { title, description, status } = req.body;
  const updatedTask = taskStore.updateTask(id, { title, description, status });
  if (!updatedTask) {
    return res.status(404).json({ error: `Task with ID ${id} not found.` });
  }

  res.json(updatedTask);
}

// DELETE /api/tasks/:id
function deleteTask(req, res) {
  const id = parseInt(req.params.id, 10);

  if (isNaN(id) || id < 1) {
    return res.status(400).json({ error: 'Invalid task ID. Must be a positive integer.' });
  }

  const deleted = taskStore.deleteTask(id);
  if (!deleted) {
    return res.status(404).json({ error: `Task with ID ${id} not found.` });
  }

  res.json({ message: 'Task deleted successfully' });
}

module.exports = {
  getAllTasks,
  getTaskById,
  createTask,
  updateTask,
  deleteTask,
};
